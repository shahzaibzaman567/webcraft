# Public app URL used for canonical links and share URLs.
APP_URL="http://localhost:3000"

# Backend API base URL.
VITE_BACKEND_URL="http://localhost:5000"

# Clerk publishable key for production authentication.
# When omitted, the app shows a development-only backend auth fallback.
VITE_CLERK_PUBLISHABLE_KEY=""

# Do not put AI provider keys in this file. They are client-visible.
# Add AI provider keys through the admin panel (/admin) instead.
