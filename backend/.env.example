PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Cloud or Local
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/webcraft?retryWrites=true&w=majority

MASTER_ENCRYPTION_SECRET=replace_with_64_hex_chars
ADMIN_API_SECRET=replace_with_a_long_random_admin_token
ADMIN_EMAIL=shahzaibzaman.official@gmail.com

# Clerk backend verification (required in production)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Only used outside production to allow local email-header testing
ALLOW_DEV_AUTH=true

# Optional live Supabase project mirror (MongoDB remains the source of truth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact email / nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

DATA_DIR=./data
TRUST_PROXY=0
AI_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS=8

# Inngest background jobs for AI generation/chat (prevents HTTP timeouts)
INNGEST_APP_ID=webcraft
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Use 1 to run against a local Inngest dev server, or provide its URL
INNGEST_DEV=
INNGEST_BASE_URL=

GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# Adsterra / Monetization defaults (admin panel can update these live)
ADSTERRA_POPUNDER_URL=
ADSTERRA_SMARTLINK_URL=
